# apps/api — NestJS Jubelio integration env contract.
# Copy to apps/api/.env. Never commit real secrets.
#
# DATABASE_URL is NOT listed here — bootstrap-env.ts cascades it from
# apps/web/.env at runtime. In prod it comes from .env.production on the
# Hostinger VPS, loaded into the container by docker-compose.prod.yml.

# ────────────────────────────────────────────────
# HTTP server
# ────────────────────────────────────────────────
# Defaults to 3001 if unset. apps/web runs on 3000.
PORT=3001

# ────────────────────────────────────────────────
# CORS — comma-separated allowed origins. Empty = CORS disabled (same-origin only).
# Use "*" only for dev. In prod set the public apps/web origin.
# Example: https://elorae.cloud
# ────────────────────────────────────────────────
CORS_ORIGINS=

# ────────────────────────────────────────────────
# Swagger /docs (HTTP Basic auth). If either is missing, /docs is disabled.
# ────────────────────────────────────────────────
SWAGGER_USER=
SWAGGER_PASS=

# ────────────────────────────────────────────────
# Jubelio integration
# ────────────────────────────────────────────────
# Base URL. Defaults to https://api2.jubelio.com if unset.
JUBELIO_API_BASE_URL=https://api2.jubelio.com

# Account credentials. The api refreshes its 12h session token via POST /login
# and stores it in the SystemSetting row keyed JUBELIO_SESSION_TOKEN.
JUBELIO_USER=
JUBELIO_PASS=

# Optional. Email stamped as the picker on WMS picklist pushes; Jubelio validates
# it against its own staff list. Falls back to JUBELIO_USER when unset or blank.
# Left commented so a copied env does not ship an empty picker_id.
# JUBELIO_PICKER_EMAIL=

# Webhook signature secret. Set in Jubelio dashboard → Pengaturan → Developer →
# Webhook. apps/api verifies sha256(rawBody + secret) on every inbound webhook.
JUBELIO_WEBHOOK_SECRET=

# Optional. BullMQ worker concurrency for the Jubelio queues. Defaults to 1.
# Leave it at 1 unless you have read the pick/pack ordering follow-up in
# docs/FOLLOWUPS.md — the two pushes are independent queue rows, and raising
# concurrency reorders them beyond the reordering that retry backoff already
# causes.
# JUBELIO_WORKER_CONCURRENCY=1

# ────────────────────────────────────────────────
# Redis (BullMQ transport for the Jubelio webhook queue)
# ────────────────────────────────────────────────
# Defaults to redis://localhost:6379 if unset.
# Local dev: docker compose -f docker-compose.dev.yml up -d redis
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────────
# Internal API auth bridge (HMAC-SHA256 between apps/web ↔ apps/api)
# ────────────────────────────────────────────────
# Shared secret used by apps/web to sign every web→api request and by
# apps/api to verify. Must match the value in apps/web/.env exactly.
# Generate: openssl rand -base64 32
INTERNAL_API_SECRET=

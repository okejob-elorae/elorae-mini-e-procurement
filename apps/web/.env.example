# apps/web — Next.js ERP env contract.
# Copy to apps/web/.env. Never commit real secrets.

# ────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────
# Local dev points at the MariaDB test-bed container from docker-compose.dev.yml
# (port 3308), NOT at prod. Start it with:
#   docker compose -f docker-compose.dev.yml up -d db
# Do not change this to 3306 — a different MySQL may be listening there, and you
# get a silently wrong database rather than a connection error.
DATABASE_URL=mysql://elorae:elorae@127.0.0.1:3308/elorae

# Inert bookmark for the prod SSH tunnel (ssh -fNL 3307:127.0.0.1:3306 ...).
# NO CODE READS THIS. Reaching prod means setting DATABASE_URL yourself, and an
# ambient prod DATABASE_URL makes every later command in that shell destructive
# with no signal. See docs/local-db-testbed.md.
DATABASE_URL_PROD=mysql://elorae:<prod-password>@127.0.0.1:3307/elorae

# ────────────────────────────────────────────────
# NextAuth
# ────────────────────────────────────────────────
# 32+ byte secret for JWT signing. Generate: openssl rand -base64 32
# AUTH_SECRET is the v5 name and is what `proxy.ts` reads FIRST
# (`AUTH_SECRET ?? NEXTAUTH_SECRET`). Set AUTH_SECRET; keep both to the same
# value if you also set the legacy alias.
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ────────────────────────────────────────────────
# Encryption (supplier PII, AES-256)
# ────────────────────────────────────────────────
# 32 hex bytes. Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# ────────────────────────────────────────────────
# Internal apps/api URL (server-action proxy target for Jubelio endpoints)
# Defaults to http://localhost:3001 if unset.
# ────────────────────────────────────────────────
INTERNAL_API_URL=http://localhost:3001

# ────────────────────────────────────────────────
# Cron endpoint guard (POST /api/cron/...)
# ────────────────────────────────────────────────
# Optional in dev; required in production. Guards the manual /api/cron/* smoke
# routes only — the real jobs run in-process via node-cron and bypass this.
CRON_SECRET=

# ────────────────────────────────────────────────
# Firebase — client SDK (PWA push notifications)
# NEXT_PUBLIC_* are bundled into the browser.
# ────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=elorae-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=elorae-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=elorae-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ────────────────────────────────────────────────
# Firebase — Admin SDK (server-side notification dispatch)
# Optional in dev; required in production.
# ────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=elorae-prod
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@elorae-prod.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ────────────────────────────────────────────────
# Cloudflare R2 (file uploads, GRN photos)
# ────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=elorae-erp
# Public read URL for the bucket, copied from its Cloudflare settings page.
# Shape is https://pub-<hash>.r2.dev — there is no uploads.elorae.* domain.
# `lib/items/images/trusted-hosts.ts` derives the allowed image host from this,
# so a wrong value here fails image validation rather than erroring at upload.
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ────────────────────────────────────────────────
# Internal API auth bridge (HMAC-SHA256 between apps/web ↔ apps/api)
# ────────────────────────────────────────────────
# Shared secret used by apps/web to sign every web→api request and by
# apps/api to verify. Must match the value in apps/api/.env exactly.
# Generate: openssl rand -base64 32
INTERNAL_API_SECRET=

# ────────────────────────────────────────────────
# Redis (distributed lock for concurrent decision serialization)
# ────────────────────────────────────────────────
# In docker-compose: redis://redis:6379
# For local-dev outside Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────────
# SerpAPI (optional — store place search on backoffice form)
# ────────────────────────────────────────────────
# Used by "Find on map" / "Cari di peta" on store create/edit.
# Without this key, the Leaflet map + paste-coords still work.
# Get a key at https://serpapi.com/
SERPAPI_KEY=

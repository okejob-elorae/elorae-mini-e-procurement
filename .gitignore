node_modules/
.turbo/
.pnpm-store/

packages/db/dist/
packages/db/generated/

reference/*
docs/superpowers/
meeting-progress-*.md
.vercel

other-sources
# Root-level env files for VPS deploy. Per-app .env files have their own gitignore.
.env
.env.*
!.env.*.example

# Root-level scratchpad artifacts (screenshots, notes, scratch scripts)
/*.png
/*.webm
/log.md
/scratchpad-*.js
/scratchpad-*.mjs

scripts/legacy-master

# TSC build outputs inside lib/ (source is .ts; compiled JS must not ship)
apps/web/lib/**/*.js
apps/web/lib/**/*.d.ts
apps/web/lib/**/*.js.map

# Database dumps / restore artefacts — full customer PII, must never be committed.
# The restore procedure uses a temp dir, but a stray dump in the tree is one `git add -A`
# away from being published in a public-ish repo.
*.sql.gz
*.sql.gz.gpg
restore.sql

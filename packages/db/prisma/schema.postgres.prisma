  @@unique([channel, orderId, variantSku])
  @@index([parentSku, orderDate])
  @@index([orderDate])
  @@index([channel])
  @@index([importBatchId])
  @@index([orderStatus])
  @@index([itemId])
  @@index([resolutionStatus])
}

model SalesHistoryImport {
  id           String         @id @default(cuid())

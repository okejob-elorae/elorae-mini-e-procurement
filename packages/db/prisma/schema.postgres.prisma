generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// ==========================================
// AUTHENTICATION (Phase 1 Extended)
// ==========================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  pinHash       String?
  role          Role      @default(USER)
  roleId        String?
  roleDefinition RoleDefinition? @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fcmToken      String?
  themePantoneTcx  String?
  themePrimaryHex  String    @default("#334155")
  themeFontId      String?
  themePantone     PantoneColor? @relation(fields: [themePantoneTcx], references: [tcx], onDelete: SetNull, onUpdate: Restrict)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  auditLogs       AuditLog[]
  pinAttempts     PinAttempt[]
  notificationQueue NotificationQueue[]
  purchaseOrders PurchaseOrder[]
  poStatusChanges POStatusHistory[]
  stockAdjustmentsApproved StockAdjustment[] @relation("ApprovedAdjustments")
  stockAdjustmentsCreated  StockAdjustment[] @relation("CreatedAdjustments")
  vendorReturnsCreated    VendorReturn[]
  vendorReturnsCompleted  VendorReturn[] @relation("VendorReturnCompleted")
  pantoneColorFavorites   PantoneColorFavorite[]
  planYearsCreated        PlanYear[]
  salesHistoryImports     SalesHistoryImport[]
  forecastConfigsCreated  ForecastConfig[]
  suppliersApproved       Supplier[]
  grnsOwnerApproved       GRN[]      @relation("GRNOwnerApproved")
  grnsOwnerDeclined       GRN[]      @relation("GRNOwnerDeclined")
  enqueuedOutbox          JubelioOutbox[] @relation("EnqueuedOutbox")
  jubelioPushDefaultsUpdates JubelioPushDefaults[] @relation("JubelioPushDefaultsUpdater")
  priceChangeLogs         ItemPriceChangeLog[]
  salesReturnsDecided     SalesReturn[]     @relation("SalesReturnDecidedBy")
  salesReturnItemsDecided SalesReturnItem[] @relation("SalesReturnItemDecidedBy")
  storeVisits   StoreVisit[]
  fieldSalesOrders FieldSalesOrder[] @relation("FieldSalesOrderSalesman")
  fieldSalesDeliveries FieldSalesDelivery[] @relation("FieldSalesDeliveryUser")
  fieldSalesLinesAdded FieldSalesOrderLine[] @relation("FieldSalesLineAddedBy")
  taxInvoicesMarked TaxInvoice[] @relation("TaxInvoiceMarkedBy")
  storeChangeRequestsMade      StoreChangeRequest[] @relation("StoreChangeRequestedBy")
  storeChangeRequestsReviewed  StoreChangeRequest[] @relation("StoreChangeReviewedBy")
  vanStock      VanStock[] @relation("VanStockUser")
  vanLoadsAsCanvasser VanLoad[] @relation("VanLoadCanvasser")
  vanLoadsLoaded      VanLoad[] @relation("VanLoadLoadedBy")
  vanSales      VanSale[] @relation("VanSaleSalesman")
  vanReconciles VanReconcile[] @relation("VanReconcileCanvasser")
  vanReconcilesDone VanReconcile[] @relation("VanReconcileBy")
  assignedStoreId String?
  spgSales      SpgSale[] @relation("SpgSaleSalesman")
  spgSalesCreated SpgSale[] @relation("SpgSaleCreatedBy")
  storesHandled Store[]   @relation("StoreSalesman")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([roleId])
  @@index([themePantoneTcx])
  @@index([assignedStoreId])
  receivablesAsSalesman  Receivable[]     @relation("ReceivableSalesman")
  collectionNotes        CollectionNote[] @relation("CollectionNoteSalesman")
  paymentClaimsAsSalesman PaymentClaim[]  @relation("PaymentClaimSalesman")
  paymentClaimsVerified  PaymentClaim[]   @relation("PaymentClaimVerifier")
  paymentClaimsCreated   PaymentClaim[]   @relation("PaymentClaimCreator")
  storeReturnsAsSalesman StoreReturn[]     @relation("StoreReturnSalesman")
  warehouseReturnsCounted WarehouseReturn[] @relation("WarehouseReturnCounter")
  returnChargesBorne     ReturnCharge[]    @relation("ReturnChargeBearer")
  returnChargesDecided   ReturnCharge[]    @relation("ReturnChargeDecider")
  fotoDiunggah           Foto[]            @relation("FotoUploader")
  konsiDikunci           ConsignmentCycle[] @relation("KonsiLocker")
  konsiDilaporkan        ConsignmentReport[] @relation("KonsiReporter")
  konsiKomisiSaya        ConsignmentCommission[] @relation("KonsiSpg")
  konsiKomisiDibayar     ConsignmentCommission[] @relation("KonsiPayer")
  kolsCreated       Kol[]         @relation("KolCreator")
  kolBriefsCreated  KolBrief[]    @relation("KolBriefCreator")
  contentsAssigned  ContentPlan[] @relation("ContentAssignee")
  contentsCreated   ContentPlan[] @relation("ContentCreator")
  colorPalettesCreated ColorPalette[] @relation("ColorPaletteCreator")
  kolCampaignsCreated  KolCampaign[]  @relation("KolCampaignCreator")
  kolBriefsPic         KolBrief[]     @relation("KolBriefPic")
  kolContentsApproved  KolContent[]   @relation("KolContentApprover")
  kolNotesWritten      KolNote[]      @relation("KolNoteAuthor")
  kolAgendasOwned      KolAgenda[]    @relation("KolAgendaOwner")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ==========================================
// RBAC (Role-Based Access Control)
// ==========================================
model RoleDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissionsVersion Int @default(1)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique    // e.g. "suppliers:create"
  module      String              // e.g. "suppliers"
  action      String              // e.g. "create"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String         @id @default(cuid())
  roleId       String
  permissionId String
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ==========================================
// MASTER DATA (Phase 2)
// ==========================================
model SupplierType {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  isActive  Boolean    @default(true)
  sortOrder Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  suppliers Supplier[]
}

model Supplier {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  typeId           String
  type             SupplierType    @relation(fields: [typeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  address          String?
  phone            String?
  email            String?
  bankName         String?
  bankAccountEnc   String?
  bankAccountName  String?
  taxWithholding   String?
  isPkp            Boolean?
  hasNpwp          Boolean          @default(true)
  npwpEnc          String?          @db.Text
  npwpLast4        String?
  isActive         Boolean          @default(true)
  status           SupplierStatus  @default(PENDING_APPROVAL)
  approvedById     String?
  approvedBy       User?           @relation(fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedAt       DateTime?
  rejectionReason  String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  purchaseOrders   PurchaseOrder[]
  workOrders       WorkOrder[]
  workOrderSteps   WorkOrderStep[]
  grns             GRN[]
  vendorReturns    VendorReturn[]
  planCmtAllocations PlanCmtAllocation[]
  planStages       PlanStage[]      @relation("PlanStageSupplier")
  planStageSteps   PlanStageStep[]  @relation("PlanStageStepSupplier")
  processChain     SupplierProcess[]
  @@index([typeId])
  @@index([code])
  @@index([status])
  @@index([approvedById])
}

model ProcessTemplate {
  id               String              @id @default(cuid())
  name             String              @unique
  leadTimeType     LeadTimeType        @default(FIXED)
  days             Int
  rateQty          Int?
  notes            String?
  isApproval       Boolean             @default(false)
  sopInstructions  String?             @db.Text
  isActive         Boolean             @default(true)
  sortOrder        Int                 @default(0)
  supplierSteps    SupplierProcess[]
  chainTemplateSteps ChainTemplateStep[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([isActive])
}

model ChainTemplate {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?             @db.Text
  isActive    Boolean             @default(true)
  steps       ChainTemplateStep[]
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([isActive])
}

model ChainTemplateStep {
  id                String          @id @default(cuid())
  chainTemplateId   String
  chainTemplate     ChainTemplate   @relation(fields: [chainTemplateId], references: [id], onDelete: Cascade)
  processTemplateId String
  processTemplate   ProcessTemplate @relation(fields: [processTemplateId], references: [id], onDelete: Restrict)
  sequence          Int
  notes             String?

  @@unique([chainTemplateId, sequence])
  @@index([processTemplateId])
  @@index([chainTemplateId])
}

model SupplierProcess {
  id                String          @id @default(cuid())
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  processTemplateId String
  processTemplate   ProcessTemplate @relation(fields: [processTemplateId], references: [id], onDelete: Restrict)
  sequence          Int
  overrideDays      Int?
  overrideRateQty   Int?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([supplierId, sequence])
  @@index([supplierId])
  @@index([processTemplateId])
}

model UOM {
  id              String          @id @default(cuid())
  code            String          @unique
  nameId          String
  nameEn          String
  description     String?
  isActive        Boolean         @default(true)
  items           Item[]
  fabricRolls     FabricRoll[]
  fromConversions UOMConversion[] @relation("FromConversions")
  toConversions   UOMConversion[] @relation("ToConversions")
  createdAt       DateTime        @default(now())
}

model UOMConversion {
  id          String   @id @default(cuid())
  fromUomId   String
  toUomId     String
  fromUom     UOM      @relation("FromConversions", fields: [fromUomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toUom       UOM      @relation("ToConversions", fields: [toUomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  factor      Decimal  @db.Decimal(10,6)
  isDefault   Boolean  @default(false)
  @@unique([fromUomId, toUomId])
  @@index([fromUomId])
  @@index([toUomId])
}

model ItemCategory {
  id        String   @id @default(cuid())
  code      String?  @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items            Item[]
  jubelioCategoryMappings JubelioCategoryMapping[]
  planCategories   PlanCategory[]
}

model Store {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  address        String         @db.Text
  phone          String?
  contactName    String?
  termsType      StoreTermsType
  paymentTempo   Int            @default(0)
  marginPercent  Decimal?       @db.Decimal(5, 2)
  lat            Decimal?       @db.Decimal(10, 7)
  lng            Decimal?       @db.Decimal(10, 7)
  checkinRadiusMeters Int?
  creditLimit    Decimal?       @db.Decimal(15, 2)
  maxOpenInvoices Int?
  storeClass     String?
  isPkp          Boolean        @default(false)
  npwp           String?
  nitku          String?
  isActive       Boolean        @default(true)
  groupId        String?
  salesmanId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  group          StoreGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salesman       User?          @relation("StoreSalesman", fields: [salesmanId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  visits         StoreVisit[]
  fieldSalesOrders FieldSalesOrder[]
  promoStores    PromoStore[]
  storeChangeRequests StoreChangeRequest[]
  vanSales       VanSale[]
  spgSales       SpgSale[]

  @@index([isActive, name])
  @@index([groupId])
  @@index([salesmanId])
  receivables    Receivable[]
  collectionNotes CollectionNote[]
  paymentClaims  PaymentClaim[]
  storeReturns   StoreReturn[]
  warehouseReturns WarehouseReturn[]
  returnCharges  ReturnCharge[]
  konsiCycles    ConsignmentCycle[]
  konsiShipments ConsignmentShipment[]
  stockMovements StoreStockMovement[]
  transfersOut   StoreTransfer[] @relation("StoreTransferFrom")
  transfersIn    StoreTransfer[] @relation("StoreTransferTo")
  receipts       StoreReceipt[]
  opnames        StoreOpname[]
  stockRequests  StockRequest[]
  recommendations StoreRecommendation[]
  lostSales      LostSale[]
}

model StoreGroup {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores    Store[]
}

model StoreVisit {
  id           String    @id @default(cuid())
  storeId      String
  userId       String
  checkinAt    DateTime  @default(now())
  checkoutAt   DateTime?
  checkinLat   Decimal   @db.Decimal(10, 7)
  checkinLng   Decimal   @db.Decimal(10, 7)
  checkoutLat  Decimal?  @db.Decimal(10, 7)
  checkoutLng  Decimal?  @db.Decimal(10, 7)
  checkinDistanceMeters Int?
  checkinOutOfRadius     Boolean   @default(false)
  autoClosed   Boolean   @default(false)
  checkinAccuracyMeters Int?
  checkinFlags Json?
  outcome      String?
  outcomeNote  String?   @db.Text
  clientId     String?   @unique
  capturedOffline Boolean @default(false)
  syncedAt     DateTime?

  store        Store     @relation(fields: [storeId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  fieldSalesOrders FieldSalesOrder[]
  photos       VisitPhoto[]
  storeChangeRequests StoreChangeRequest[]

  @@index([userId, checkoutAt])
  @@index([storeId, checkinAt])
}

model VisitPhoto {
  id         String   @id @default(cuid())
  visitId    String
  clientId   String   @unique
  url        String
  r2Key      String
  caption    String?
  capturedAt DateTime
  displayGuideId String?
  createdAt  DateTime @default(now())
  visit      StoreVisit @relation(fields: [visitId], references: [id])

  @@index([visitId])
}

model StoreChangeRequest {
  id             String                   @id @default(cuid())
  storeId        String
  visitId        String
  requestedById  String
  status         StoreChangeRequestStatus @default(PENDING)

  name           String
  address        String                   @db.Text
  phone          String?
  contactName    String?
  lat            Decimal?                 @db.Decimal(10, 7)
  lng            Decimal?                 @db.Decimal(10, 7)

  oldName        String
  oldAddress     String                   @db.Text
  oldPhone       String?
  oldContactName String?
  oldLat         Decimal?                 @db.Decimal(10, 7)
  oldLng         Decimal?                 @db.Decimal(10, 7)

  reviewedById   String?
  reviewedAt     DateTime?
  rejectReason   String?                  @db.Text

  pendingKey     String?                  @unique

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  store          Store                    @relation(fields: [storeId], references: [id])
  visit          StoreVisit               @relation(fields: [visitId], references: [id])
  requestedBy    User                     @relation("StoreChangeRequestedBy", fields: [requestedById], references: [id])
  reviewedBy     User?                    @relation("StoreChangeReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([storeId, status])
}

model FieldSalesOrder {
  id            String                @id @default(cuid())
  orderNo       String                @unique
  storeId       String
  salesmanId    String
  visitId       String?
  status        FieldSalesOrderStatus @default(PENDING_APPROVAL)
  deliveryStatus FieldSalesDeliveryStatus @default(PENDING)
  orderType     FieldSalesOrderType   @default(PUTUS)
  subtotal      Decimal               @db.Decimal(15, 2)
  total         Decimal               @db.Decimal(15, 2)
  orderDiscountAmount Decimal         @default(0) @db.Decimal(15, 2)
  appliedOrderPromoId String?
  note          String?               @db.Text
  approvedAt    DateTime?
  approvedById  String?
  rejectedAt    DateTime?
  rejectedById  String?
  rejectReason  String?               @db.Text
  closedAt      DateTime?
  closedById    String?
  closeReason   String?               @db.Text
  idempotencyKey String?              @unique
  kreditDitahan Boolean               @default(false)
  kreditCatatan String?               @db.Text
  remoteChannel String?
  preorderWindowId String?
  cancelledById String?
  cancelledAt   DateTime?
  replacesOrderId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  store         Store                 @relation(fields: [storeId], references: [id])
  salesman      User                  @relation("FieldSalesOrderSalesman", fields: [salesmanId], references: [id])
  visit         StoreVisit?           @relation(fields: [visitId], references: [id])
  lines         FieldSalesOrderLine[]
  deliveries    FieldSalesDelivery[]
  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([salesmanId, createdAt])
  @@index([replacesOrderId])
  @@index([preorderWindowId])
}

model FieldSalesOrderLine {
  id           String          @id @default(cuid())
  orderId      String
  itemId       String
  variantSku   String          @default("")
  productName  String
  qty          Int
  unitPrice    Decimal         @db.Decimal(15, 2)
  lineTotal    Decimal         @db.Decimal(15, 2)
  discountAmount Decimal       @default(0) @db.Decimal(15, 2)
  appliedPromoId String?
  isBonus        Boolean         @default(false)
  bonusPromoId   String?
  requestedUnitPrice Decimal?  @db.Decimal(15, 2)
  appealReason String?  @db.Text
  deliveredQty Int @default(0)
  cancelledQty Int @default(0)
  addedById    String?
  addedBy      User?           @relation("FieldSalesLineAddedBy", fields: [addedById], references: [id])
  order        FieldSalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item         Item            @relation(fields: [itemId], references: [id])
  deliveryLines FieldSalesDeliveryLine[]
  @@index([orderId])
  @@index([itemId])
}

model FieldSalesDelivery {
  id             String                   @id @default(cuid())
  docNo          String                   @unique
  orderId        String
  deliveredAt    DateTime
  deliveredById  String
  invoiceDate    DateTime
  dueDate        DateTime
  subtotal       Decimal                  @db.Decimal(15, 2)
  discountAmount Decimal                  @default(0) @db.Decimal(15, 2)
  total          Decimal                  @db.Decimal(15, 2)
  note           String?                  @db.Text
  idempotencyKey String?                  @unique
  receivedByName String?
  receivedAt     DateTime?
  podPhotoUrl    String?
  createdAt      DateTime                 @default(now())
  order          FieldSalesOrder          @relation(fields: [orderId], references: [id])
  deliveredBy    User                     @relation("FieldSalesDeliveryUser", fields: [deliveredById], references: [id])
  lines          FieldSalesDeliveryLine[]
  taxInvoice     TaxInvoice?
  @@index([orderId])
  @@index([deliveredAt])
  receivable     Receivable?
}

model FieldSalesDeliveryLine {
  id             String              @id @default(cuid())
  deliveryId     String
  orderLineId    String
  itemId         String
  variantSku     String              @default("")
  productName    String
  qty            Int
  unitPrice      Decimal?            @db.Decimal(15, 2)
  discountAmount Decimal             @default(0) @db.Decimal(15, 2)
  lineTotal      Decimal?            @db.Decimal(15, 2)
  delivery       FieldSalesDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderLine      FieldSalesOrderLine @relation(fields: [orderLineId], references: [id])
  item           Item                @relation(fields: [itemId], references: [id])
  @@index([deliveryId])
  @@index([orderLineId])
}

model TaxInvoice {
  id              String             @id @default(cuid())
  deliveryId      String             @unique
  status          TaxInvoiceStatus   @default(PENDING)
  invoiceNo       String?
  markedAt        DateTime?
  markedById      String?
  reason          String?            @db.Text
  notaPrintedAt   DateTime?
  notaPrintedById String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  delivery        FieldSalesDelivery @relation(fields: [deliveryId], references: [id])
  markedBy        User?              @relation("TaxInvoiceMarkedBy", fields: [markedById], references: [id])

  @@index([status])
}

enum FieldSalesOrderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum FieldSalesOrderType {
  PUTUS
  KONSI
}

enum FieldSalesDeliveryStatus {
  PENDING
  PARTIAL
  DELIVERED
  CLOSED
}

enum TaxInvoiceStatus {
  PENDING
  CREATED
  NOT_REQUIRED
}

enum ReserveSource {
  JUBELIO
  FIELD_SALES
  FIELD_SALES_KONSI
}

enum PromoType {
  PERCENT
  FIXED
  TIERED
  BONUS
}

enum PromoLevel {
  LINE
  ORDER
}

model Promo {
  id               String         @id @default(cuid())
  name             String
  type             PromoType
  level            PromoLevel
  termsType        StoreTermsType @default(PUTUS)
  value            Decimal?       @db.Decimal(15, 2)
  minQty           Int?
  minOrderSubtotal Decimal?       @db.Decimal(15, 2)
  minOrderQty      Int?
  bonusBuyQty      Int?
  bonusFreeQty     Int?
  bonusItemId      String?
  allStores        Boolean        @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  priority         Int            @default(0)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            PromoItem[]
  stores           PromoStore[]
  tiers            PromoTier[]
  @@index([isActive, level])
}

model PromoItem {
  id      String @id @default(cuid())
  promoId String
  itemId  String
  promo   Promo  @relation(fields: [promoId], references: [id], onDelete: Cascade)
  item    Item   @relation(fields: [itemId], references: [id])
  @@unique([promoId, itemId])
  @@index([itemId])
}

model PromoStore {
  id      String @id @default(cuid())
  promoId String
  storeId String
  promo   Promo  @relation(fields: [promoId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id])
  @@unique([promoId, storeId])
  @@index([storeId])
}

model PromoTier {
  id        String  @id @default(cuid())
  promoId   String
  minQty    Int
  unitPrice Decimal @db.Decimal(15, 2)
  promo     Promo   @relation(fields: [promoId], references: [id], onDelete: Cascade)
  @@unique([promoId, minQty])
}

model Item {
  id               String            @id @default(cuid())
  sku              String            @unique
  nameId           String
  nameEn           String
  description      String?
  type             ItemType
  uomId            String
  uom              UOM               @relation(fields: [uomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categoryId       String?
  category         ItemCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  variants         Json?
  isActive         Boolean           @default(true)
  reorderPoint     Decimal?          @db.Decimal(10,2)
  overReceiveThreshold Decimal?      @db.Decimal(10,2)
  sellingPrice     Decimal?          @db.Decimal(14,2)
  targetMarginPercent Decimal?       @db.Decimal(5,2)
  additionalCost   Decimal?          @db.Decimal(15,2)
  defaultPpnIncluded Boolean         @default(true)
  minOrderQty      Int?
  source           ItemSource        @default(ERP)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stockMovements   StockMovement[]
  poItems          POItem[]
  inventoryValues  InventoryValue[]
  fgConsumptions   ConsumptionRule[] @relation("FGConsumptions")
  materialUsages   ConsumptionRule[] @relation("MaterialUsages")
  stockAdjustments StockAdjustment[]
  workOrdersAsFinishedGood WorkOrder[]
  workOrdersAsConsumptionMaterial WorkOrder[] @relation("WorkOrderConsumptionMaterial")
  planCategories   PlanCategory[]
  planAccessories  PlanAccessory[]
  rejectedGoodsLedger RejectedGoodsLedger[]
  fabricRolls      FabricRoll[]
  jubelioProductMappings JubelioProductMapping[]
  priceChangeLogs  ItemPriceChangeLog[]
  salesReturnItems SalesReturnItem[]
  salesHistoryRows   SalesHistory[]
  forecastResults    ForecastResult[]
  images           ItemImage[]
  fieldSalesLines  FieldSalesOrderLine[]
  fieldSalesDeliveryLines FieldSalesDeliveryLine[]
  promoItems       PromoItem[]
  vanStock         VanStock[]
  vanLoadLines     VanLoadLine[]
  vanSaleLines     VanSaleLine[]
  vanReconcileLines VanReconcileLine[]
  spgSaleLines     SpgSaleLine[]
  storeStockMovements StoreStockMovement[]
  storeTransferLines  StoreTransferLine[]
  @@index([type, isActive])
  @@index([sku])
  @@index([uomId])
  @@index([categoryId])
  commissionPerPcs Decimal @default(0) @db.Decimal(15, 2)
  material         String?
  careInstructions String?  @db.Text
  sizeChartId      String?
  kgPerRoll        Decimal?  @db.Decimal(10, 2)

  kolBriefItems     KolBriefItem[]
  contentPlans      ContentPlan[]
  kolShipmentLines  KolShipmentLine[]
}

model ItemImage {
  id                      String    @id @default(cuid())
  itemId                  String
  item                    Item      @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  variantSku              String?
  url                     String    @db.VarChar(500)
  sortOrder               Int       @default(0)
  jubelioImageId          String?   @unique
  jubelioImageKey         String?   @db.VarChar(500)
  jubelioImageThumbnail   String?   @db.VarChar(500)
  syncedAt                DateTime?
  source                  String    @default("ERP_UPLOAD")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  @@index([itemId, variantSku, sortOrder])
  @@index([itemId, jubelioImageId])
}

model ConsumptionRule {
  id              String   @id @default(cuid())
  finishedGoodId  String
  finishedGood    Item     @relation("FGConsumptions", fields: [finishedGoodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  materialId      String
  material        Item     @relation("MaterialUsages", fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  qtyRequired     Decimal  @db.Decimal(10,4)
  wastePercent    Decimal  @default(0) @db.Decimal(5,2)
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  @@unique([finishedGoodId, materialId])
  @@index([finishedGoodId])
  @@index([materialId])
}

// ==========================================
// PROCUREMENT (Phase 2)
// ==========================================
model PurchaseOrder {
  id          String          @id @default(cuid())
  docNumber   String          @unique
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status           POStatus        @default(DRAFT)
  etaDate          DateTime?
  paymentDueDate   DateTime?
  paidAt           DateTime?
  currency         String          @default("IDR")
  totalAmount      Decimal         @default(0) @db.Decimal(15,2)
  taxAmount        Decimal         @default(0) @db.Decimal(15,2)
  grandTotal       Decimal         @default(0) @db.Decimal(15,2)
  notes            String?        @db.Text
  terms            String?        @db.Text
  createdById      String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items       POItem[]
  grns        GRN[]
  statusHistory POStatusHistory[]
  workOrders  WorkOrder[]
  syncStatus  SyncStatus      @default(SYNCED)
  chainSnapshot           Json?
  chainTotalDays          Int?
  chainConfirmedStepIndex Int?
  chainConfirmedAt        DateTime?
  chainConfirmedSource    String?
  actualLeadDays          Int?
  ppnRatePercent          Decimal?        @db.Decimal(5,2)
  closedAt                DateTime?
  closedById              String?
  closeReason             String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  planStageId             String?
  planStage               PlanStage?      @relation("PurchaseOrderPlanStage", fields: [planStageId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([supplierId])
  @@index([planStageId])
  @@index([createdById])
  @@index([status])
  @@index([etaDate])
  @@index([docNumber])
}

model POItem {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /** Matches Item.variants[].sku; null = non-variant / parent SKU stock bucket */
  variantSku  String?
  qty         Decimal       @db.Decimal(10,2)
  price       Decimal       @db.Decimal(15,2)
  ppnIncluded Boolean       @default(true)
  receivedQty Decimal       @default(0) @db.Decimal(10,2)
  uomId       String
  notes       String?
  createdAt   DateTime      @default(now())
  @@index([poId])
  @@index([itemId])
  @@index([poId, itemId, variantSku])
}

model POStatusHistory {
  id            String        @id @default(cuid())
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  status        POStatus
  changedById   String
  changedBy     User          @relation(fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notes         String?
  paymentEvent  String?       // 'MARKED' | 'UNMARKED' when record is for supplier payment marked/unmarked
  createdAt     DateTime      @default(now())
  @@index([poId, createdAt])
  @@index([changedById])
}

// ==========================================
// INVENTORY & COSTING (Phase 3)
// ==========================================
model InventoryValue {
  id          String   @id @default(cuid())
  itemId      String
  variantSku  String?
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qtyOnHand   Decimal  @default(0) @db.Decimal(10,2)
  reservedQty Decimal  @default(0) @db.Decimal(10,2)
  avgCost     Decimal  @default(0) @db.Decimal(15,2)
  totalValue  Decimal  @default(0) @db.Decimal(15,2)
  lastUpdated DateTime @default(now())
  @@unique([itemId, variantSku])
  @@index([itemId])
}

model GRN {
  id            String    @id @default(cuid())
  docNumber     String    @unique
  poId          String?
  po            PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grnDate       DateTime  @default(now())
  receivedBy    String
  totalAmount   Decimal   @db.Decimal(15,2)
  ppnAmount     Decimal?  @db.Decimal(15,2)
  notes         String?
  photoUrls     String?
  items         Json      
  requiresOwnerApproval Boolean @default(false)
  ownerApprovedAt DateTime?
  ownerApprovedById String?
  ownerApprovedBy User?    @relation("GRNOwnerApproved", fields: [ownerApprovedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerDeclinedAt DateTime?
  ownerDeclinedById String?
  ownerDeclinedBy User?    @relation("GRNOwnerDeclined", fields: [ownerDeclinedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  syncStatus    SyncStatus @default(SYNCED)
  localId       String?
  idempotencyKey String?  @unique
  createdAt     DateTime  @default(now())
  fabricRolls   FabricRoll[]
  vendorReturns VendorReturn[]
  @@index([poId])
  @@index([supplierId])
  @@index([grnDate])
  @@index([docNumber])
  @@index([ownerApprovedById])
  @@index([ownerDeclinedById])
}

model FabricRoll {
  id            String   @id @default(cuid())
  grnId         String
  grn           GRN      @relation(fields: [grnId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rollCode      String   @unique
  rollRef       String
  initialLength Decimal  @db.Decimal(10,2)
  remainingLength Decimal @db.Decimal(10,2)
  uomId         String
  uom           UOM      @relation(fields: [uomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  isClosed      Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  @@index([grnId])
  @@index([itemId])
  @@index([itemId, isClosed, remainingLength])
  @@index([uomId])
  @@index([rollCode])
}

model StockMovement {
  id           String   @id @default(cuid())
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type         MoveType
  refType      String
  refId        String
  refDocNumber String
  qty          Decimal  @db.Decimal(10,2)
  variantSku   String?
  unitCost     Decimal? @db.Decimal(15,2)
  totalCost    Decimal? @db.Decimal(15,2)
  balanceQty   Decimal  @db.Decimal(10,2)
  balanceValue Decimal  @db.Decimal(15,2)
  notes        String?
  createdAt    DateTime @default(now())
  @@index([itemId, createdAt])
  @@index([refType, refId])
}

model StockAdjustment {
  id            String   @id @default(cuid())
  docNumber     String   @unique
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type          AdjustmentType
  qtyChange     Decimal  @db.Decimal(10,2)
  reason        String
  evidenceUrl   String?
  prevQty       Decimal  @db.Decimal(10,2)
  newQty        Decimal  @db.Decimal(10,2)
  prevAvgCost   Decimal  @db.Decimal(15,2)
  newAvgCost    Decimal  @db.Decimal(15,2)
  approvedById  String?
  approvedBy    User?    @relation("ApprovedAdjustments", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdById   String?
  createdBy     User?    @relation("CreatedAdjustments", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  source           String   @default("ERP")
  idempotencyKey   String?  @unique
  externalRef      String?
  createdAt     DateTime @default(now())
  salesReturnItem SalesReturnItem?
  @@index([itemId])
  @@index([approvedById])
  @@index([createdById])
  @@index([docNumber])
  @@index([source, createdAt])
}

model StockOpname {
  id            String        @id @default(cuid())
  docNumber     String        @unique
  scope         OpnameScope
  status        OpnameStatus  @default(CREATED)
  notes         String?       @db.Text
  snapshotAt    DateTime
  assignedToId  String?
  createdById   String
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  cancelledAt   DateTime?
  items         StockOpnameItem[]
  rolls         StockOpnameRoll[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([scope])
  @@index([status])
  @@index([docNumber])
  @@index([createdById])
}

model StockOpnameItem {
  id                   String      @id @default(cuid())
  opnameId             String
  opname               StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  itemId               String
  variantSku           String?
  itemName             String
  snapshotQty          Decimal     @db.Decimal(10,2)
  countedQty           Decimal?    @db.Decimal(10,2)
  variance             Decimal?    @db.Decimal(10,2)
  currentQtyAtApproval Decimal?    @db.Decimal(10,2)
  hadDriftWarning      Boolean     @default(false)
  adjustmentId         String?
  notes                String?
  @@index([opnameId])
  @@index([itemId])
}

model StockOpnameRoll {
  id              String      @id @default(cuid())
  opnameId        String
  opname          StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  fabricRollId    String
  rollCode        String
  itemName        String
  snapshotLength  Decimal     @db.Decimal(10,2)
  countedLength   Decimal?    @db.Decimal(10,2)
  variance        Decimal?    @db.Decimal(10,2)
  notes           String?
  @@index([opnameId])
  @@index([fabricRollId])
}

model ReconciliationRun {
  id            String    @id @default(cuid())
  triggeredBy   ReconTrigger
  status        ReconRunStatus @default(RUNNING)
  totalScanned  Int       @default(0)
  inSync        Int       @default(0)
  autoCorrected Int       @default(0)
  flagged       Int       @default(0)
  startedById   String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  errorMessage  String?   @db.Text
  results       ReconciliationResult[]
  @@index([status])
  @@index([startedAt])
}

model ReconciliationResult {
  id                  String            @id @default(cuid())
  runId               String
  run                 ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId              String
  variantSku          String?
  itemName            String
  jubelioItemId       Int?
  eloraeQty           Decimal           @db.Decimal(10,2)
  jubelioQty          Decimal           @db.Decimal(10,2)
  variance            Decimal           @db.Decimal(10,2)
  action              ReconAction
  resolvedAt          DateTime?
  resolvedById        String?
  resolutionDirection ReconDirection?
  @@index([runId])
  @@index([action])
  @@index([itemId])
}

model StockReservation {
  id                 String        @id @default(cuid())
  source             ReserveSource @default(JUBELIO)
  salesorderId       Int?
  salesorderDetailId Int?          @unique
  fieldSalesLineId   String?       @unique
  itemId             String
  variantSku         String        @default("")
  qty                Decimal       @db.Decimal(15, 4)
  consumedQty        Decimal       @default(0) @db.Decimal(15, 4)
  state              ReserveState
  createdAt          DateTime      @default(now())
  resolvedAt         DateTime?
  @@index([salesorderId])
  @@index([state])
}

// ==========================================
// PRODUCTION (Phase 4)
// ==========================================
model WorkOrder {
  id              String    @id @default(cuid())
  docNumber       String    @unique
  poId            String?
  po              PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vendorId        String
  vendor          Supplier  @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  finishedGoodId  String
  finishedGood    Item      @relation(fields: [finishedGoodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumptionMaterialId String?
  consumptionMaterial   Item?     @relation("WorkOrderConsumptionMaterial", fields: [consumptionMaterialId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outputMode      OutputMode @default(GENERIC)
  plannedQty      Decimal   @db.Decimal(10,2)
  expectedConsumption Decimal? @db.Decimal(10,2)
  actualQty       Decimal?  @db.Decimal(10,2)
  targetDate      DateTime?
  status          WOStatus  @default(DRAFT)
  issuedAt        DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  canceledReason  String?
  consumptionPlan Json
  skuBreakdown    Json?
  rollBreakdown   Json?     // Optional: [{ rollRef: string, qty: number, notes?: string }], sum qty = plannedQty
  hppMarginPercent Decimal? @db.Decimal(5,2)
  hppAdditionalCost Decimal? @db.Decimal(15,2)
  notes           String?
  syncStatus      SyncStatus @default(SYNCED)
  createdById     String
  chainSnapshot           Json?
  chainTotalDays          Int?
  chainConfirmedStepIndex Int?
  chainConfirmedAt        DateTime?
  chainConfirmedSource    String?
  actualLeadDays          Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  issues          MaterialIssue[]
  receipts        FGReceipt[]
  returns         VendorReturn[]
  steps           WorkOrderStep[]
  planStages      PlanStage[] @relation("PlanStageWorkOrder")
  planCmtAllocations PlanCmtAllocation[]
  @@index([poId])
  @@index([vendorId])
  @@index([finishedGoodId])
  @@index([consumptionMaterialId])
  @@index([createdById])
  @@index([status])
  @@index([targetDate])
  @@index([docNumber])
}

model WorkOrderStep {
  id                 String   @id @default(cuid())
  woId               String
  wo                 WorkOrder @relation(fields: [woId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  sequence           Int
  stepName           String?
  supplierId         String
  supplier           Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  servicePrice       Decimal  @default(0) @db.Decimal(15,2)
  servicePpnIncluded Boolean  @default(false)
  qty                Decimal? @db.Decimal(10,2)
  totalCost          Decimal? @db.Decimal(15,2)
  issueDocNumber     String?
  receiptDocNumber   String?
  issuedAt           DateTime?
  receivedAt         DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([woId])
  @@index([supplierId])
  @@unique([woId, sequence])
}

model MaterialIssue {
  id            String    @id @default(cuid())
  docNumber     String    @unique
  woId          String
  wo            WorkOrder @relation(fields: [woId], references: [id], onDelete: Cascade)
  issueType     IssueType
  parentIssueId String?
  isPartial     Boolean   @default(false)
  splitSequence Int?
  items         Json
  totalCost     Decimal   @db.Decimal(15,2)
  issuedById    String
  issuedAt      DateTime  @default(now())
  acknowledged  Boolean   @default(false)
  ackAt         DateTime?
  ackPhotoUrl   String?
  syncStatus    SyncStatus @default(SYNCED)
  notes         String?   @db.Text
  idempotencyKey String?  @unique
  @@index([woId])
  @@index([issuedById])
  @@index([issuedAt])
  @@index([docNumber])
}

model FGReceipt {
  id             String    @id @default(cuid())
  docNumber      String    @unique
  woId           String
  wo             WorkOrder @relation(fields: [woId], references: [id], onDelete: Cascade)
  receiptType    ReceiptType
  qtyReceived    Decimal   @db.Decimal(10,2)
  qtyRejected    Decimal   @default(0) @db.Decimal(10,2)
  qtyAccepted    Decimal   @db.Decimal(10,2)
  skuBreakdown   Json?
  qcPassed       Boolean   @default(true)
  qcNotes        String?
  qcPhotos       String?
  materialCost   Decimal?  @db.Decimal(15,2)
  serviceCost    Decimal?  @db.Decimal(15,2)
  additionalCost Decimal?  @db.Decimal(15,2)
  avgCostPerUnit Decimal?  @db.Decimal(15,2)
  totalCostValue Decimal?  @db.Decimal(15,2)
  receivedById   String
  receivedAt     DateTime  @default(now())
  syncStatus     SyncStatus @default(SYNCED)
  priceChangeLogs ItemPriceChangeLog[]
  @@index([woId])
  @@index([receivedById])
  @@index([receivedAt])
  @@index([docNumber])
}

model RejectedGoodsLedger {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variantSku  String?
  qty         Decimal   @db.Decimal(10,2)
  refType     String    // FG_RECEIPT
  refId       String
  refDocNumber String
  woId        String?
  receivedAt  DateTime
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  @@index([itemId])
  @@index([refType, refId])
  @@index([woId])
  @@index([receivedAt])
}

model VendorReturn {
  id               String       @id @default(cuid())
  docNumber        String       @unique
  woId             String?
  wo               WorkOrder?   @relation(fields: [woId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  vendorId         String
  vendor           Supplier     @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grnId            String?
  grn              GRN?         @relation(fields: [grnId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  lines            Json
  totalItems       Int
  totalValue       Decimal      @db.Decimal(15,2)
  evidenceUrls     String?
  status           ReturnStatus @default(DRAFT)
  processedAt      DateTime?
  processedBy      String?
  stockImpacted    Boolean      @default(false)
  trackingNumber   String?
  receiptFileUrl   String?
  completedAt      DateTime?
  completedById    String?
  completedBy      User?        @relation("VendorReturnCompleted", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  syncStatus       SyncStatus   @default(SYNCED)
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  poId             String?
  poCreditAmount   Decimal?     @db.Decimal(15,2)
  createdAt        DateTime     @default(now())
  @@index([woId])
  @@index([vendorId])
  @@index([grnId])
  @@index([status])
  @@index([createdById])
  @@index([completedById])
  @@index([poId])
}

// ==========================================
// PRODUCTION PLANNING (Plan Kerja)
// ==========================================
model PlanYear {
  id          String          @id @default(cuid())
  year        Int             @unique
  notes       String?         @db.Text
  status      PlanYearStatus  @default(DRAFT)
  isLocked    Boolean         @default(false)
  categories  PlanCategory[]
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([createdById])
}

model PlanCategory {
  id                  String                @id @default(cuid())
  planYearId          String
  planYear            PlanYear              @relation(fields: [planYearId], references: [id], onDelete: Cascade)
  code                String
  name                String
  description         String?
  parentId            String?
  parent              PlanCategory?         @relation("PlanCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children            PlanCategory[]        @relation("PlanCategoryHierarchy")
  targetQty           Int?
  parentSharePercent  Decimal?              @db.Decimal(5,2)
  itemId              String?
  item                Item?                 @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  itemCategoryId      String?
  itemCategory        ItemCategory?         @relation(fields: [itemCategoryId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  monthlyTargets      PlanMonthly[]
  stages              PlanStage[]
  colorAllocations    PlanColorAllocation[]
  cmtAllocations      PlanCmtAllocation[]
  accessoryPlans      PlanAccessory[]
  sortOrder           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([planYearId, code])
  @@unique([planYearId, itemCategoryId])
  @@index([planYearId])
  @@index([parentId])
  @@index([itemId])
  @@index([itemCategoryId])
}

model PlanMonthly {
  id                String        @id @default(cuid())
  planCategoryId    String
  planCategory      PlanCategory  @relation(fields: [planCategoryId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  month             Int
  targetQty         Int?
  isManualOverride  Boolean       @default(false)
  notes             String?

  @@unique([planCategoryId, month])
  @@index([planCategoryId])
}

model PlanStage {
  id                    String              @id @default(cuid())
  planCategoryId        String
  planCategory          PlanCategory        @relation(fields: [planCategoryId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  name                  String
  targetQty             Int
  targetMonth           Int?
  variantSku            String?
  supplierId            String?
  supplier              Supplier?           @relation("PlanStageSupplier", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fabricNotes           String?
  colorNotes            String?
  workOrderId           String?
  workOrder             WorkOrder?          @relation("PlanStageWorkOrder", fields: [workOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planCmtAllocationId   String?             @unique
  planCmtAllocation     PlanCmtAllocation?  @relation(fields: [planCmtAllocationId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  sortOrder             Int                 @default(0)
  scheduleStart         DateTime?
  deadline              DateTime?
  steps                 PlanStageStep[]
  purchaseOrders        PurchaseOrder[]     @relation("PurchaseOrderPlanStage")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([planCategoryId])
  @@index([supplierId])
  @@index([workOrderId])
}

enum PlanStepStatus {
  BELUM
  PROSES
  SELESAI
}

model PlanStageStep {
  id                String         @id @default(cuid())

// ==========================================
// PIUTANG & PELUNASAN
// Lapisan penagihan di atas penjualan yang sudah ada. Sebelum ini Elorae tidak
// punya satu pun catatan piutang: nota tagihan terbit, lalu tidak ada yang tahu
// apakah uangnya masuk.
//
// Dua aturan uang yang tidak boleh dilonggarkan:
//   1. Klaim bukan lunas. Piutang hanya berkurang setelah admin mencocokkan
//      klaim pembayaran dengan mutasi bank.
//   2. Retur diakui sebesar barang fisik yang diterima gudang, bukan sebesar
//      yang diklaim toko.
// ==========================================

enum ReceivableSource {
  DELIVERY
  IMPORT
  MANUAL
}

model Receivable {
  id             String    @id @default(cuid())
  invoiceNo      String    @unique
  storeId        String
  invoiceDate    DateTime
  dueDate        DateTime
  amount         Decimal   @db.Decimal(15, 2)
  outstanding    Decimal   @db.Decimal(15, 2)
  paidBeforeImport Decimal @default(0) @db.Decimal(15, 2)
  settledAt      DateTime?
  source         ReceivableSource @default(DELIVERY)
  deliveryId     String?   @unique
  salesmanId     String?
  note           String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store          Store     @relation(fields: [storeId], references: [id])
  delivery       FieldSalesDelivery? @relation(fields: [deliveryId], references: [id])
  salesman       User?     @relation("ReceivableSalesman", fields: [salesmanId], references: [id])
  collectionLinks CollectionNoteReceivable[]
  claimLinks     PaymentClaimReceivable[]
  items          ReceivableItem[]

  @@index([storeId, outstanding])
  @@index([dueDate])
  @@index([salesmanId])
}

enum CollectionNoteStatus {
  BERJALAN
  SELESAI
  BATAL
}

model CollectionNote {
  id             String   @id @default(cuid())
  docNo          String   @unique
  storeId        String
  salesmanId     String
  handoverDate   DateTime
  promisedDate   DateTime
  receivedBy     String?
  amount         Decimal  @default(0) @db.Decimal(15, 2)
  photoUrl       String?

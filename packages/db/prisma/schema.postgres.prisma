  userId      String
  storeId     String
  day         String
  kind        String
  shiftCode   String?
  startTime   String?
  endTime     String?
  note        String?
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, day])
  @@index([storeId, day])
}

model SpgShiftSwap {
  id                String    @id @default(cuid())
  storeId           String
  requesterId       String
  partnerId         String
  day               String
  partnerDay        String?
  reason            String?   @db.Text
  status            String    @default("MENUNGGU_REKAN")
  partnerAnsweredAt DateTime?
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?   @db.Text
  idempotencyKey    String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([storeId, status])
  @@index([requesterId])
  @@index([partnerId])
}

model SizeChart {
  id         String   @id @default(cuid())
  name       String
  categoryId String?
  unit       String   @default("cm")
  columns    Json
  rows       Json
  note       String?  @db.Text
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

model SpgCommission {
  id          String    @id @default(cuid())
  userId      String
  storeId     String
  period      String
  unitsSold   Int
  commission  Decimal   @db.Decimal(15, 2)
  deduction   Decimal   @default(0) @db.Decimal(15, 2)
  basis       String
  lockedById  String
  lockedAt    DateTime  @default(now())
  paidAt      DateTime?
  paidById    String?
  note        String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, storeId, period])
  @@index([period])
}

model DamagedStockMovement {
  id          String   @id @default(cuid())
  itemId      String
  variantSku  String   @default("")
  productName String
  qty         Int
  kind        String
  refType     String?
  refId       String?
  value       Decimal? @db.Decimal(15, 2)
  note        String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  @@index([itemId, variantSku])
  @@index([refType, refId])
  @@index([createdAt])
}

model StockLoss {
  id             String    @id @default(cuid())
  storeId        String?
  source         String
  sourceId       String?
  sourceDocNo    String?
  totalQty       Int
  totalAmount    Decimal   @db.Decimal(15, 2)
  valueBasis     String
  status         String    @default("TERBUKA")
  note           String?   @db.Text
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?   @db.Text
  createdById    String
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines          StockLossLine[]
  shares         StockLossShare[]

  @@index([storeId, status])
  @@index([source, sourceId])
  @@index([status, createdAt])
}

model StockLossLine {
  id          String  @id @default(cuid())
  lossId      String
  itemId      String?
  variantSku  String  @default("")
  productName String
  qty         Int
  unitValue   Decimal @db.Decimal(15, 2)
  amount      Decimal @db.Decimal(15, 2)

  loss        StockLoss @relation(fields: [lossId], references: [id], onDelete: Cascade)

  @@index([lossId])
}

model StockLossShare {
  id           String    @id @default(cuid())
  lossId       String
  bearer       String
  bearerUserId String?
  amount       Decimal   @db.Decimal(15, 2)
  settledAmount Decimal  @default(0) @db.Decimal(15, 2)
  settledAt    DateTime?
  settledById  String?
  settleNote   String?   @db.Text

  loss         StockLoss @relation(fields: [lossId], references: [id], onDelete: Cascade)

  @@index([lossId])
  @@index([bearerUserId, settledAt])
  @@index([bearer, settledAt])
}

model SpgVisitorCount {
  id              String   @id @default(cuid())
  storeId         String
  userId          String
  day             String
  count           Int
  clientUpdatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, userId, day])
  @@index([storeId, day])
}

model StockLossDeduction {
  id         String   @id @default(cuid())
  shareId    String
  amount     Decimal  @db.Decimal(15, 2)
  refType    String
  refId      String
  note       String?
  createdById String
  createdAt  DateTime @default(now())

  @@index([shareId])
  @@index([refType, refId])
}

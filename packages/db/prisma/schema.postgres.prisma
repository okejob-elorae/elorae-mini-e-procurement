model SalesHistory {
  id                     String             @id @default(cuid())
  channel                SalesChannel
  orderId                String
  orderStatus            SalesHistoryStatus
  variantSku             String
  parentSku              String
  productName            String
  color                  String?
  size                   String?
  quantity               Int
  returnedQuantity       Int                @default(0)
  netQuantity            Int
  unitPrice              Decimal            @db.Decimal(15, 2)
  unitPriceAfterDiscount Decimal            @db.Decimal(15, 2)
  lineTotal              Decimal            @db.Decimal(15, 2)
  orderTotal             Decimal            @db.Decimal(15, 2)
  orderDate              DateTime
  completedDate          DateTime?
  province               String?
  city                   String?
  productCategory        String?
  itemId                 String?
  item                   Item?              @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: Restrict)

# Config for scripts/backup-db.sh. Copy to ~/.elorae-backup/env on the VPS and
# fill in. chmod 600 — it holds an R2 token.
#
# The bucket MUST be private and MUST NOT be the application's own R2 bucket.
# That one is public-read (it serves item images and visit photos over a
# pub-*.r2.dev URL), so a database dump placed there would expose every
# customer's name, address, phone and order history to anyone with the key.
# Create a separate bucket with its own API token scoped to just that bucket.

R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=elorae-backups

# S3 API endpoint for the bucket, copied from its settings page in Cloudflare.
# Leave blank ONLY if the bucket is in the default jurisdiction — the script then
# builds https://<account>.r2.cloudflarestorage.com. A jurisdiction-scoped bucket
# (EU, FedRAMP) has a different host, and addressing it at the default one fails
# in ways that look like a credentials problem.
R2_ENDPOINT=

# R2 API token for the backup bucket only. Object Read & Write is enough —
# the script uploads, copies, lists and deletes within this one bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# R2 ignores region but the aws cli requires one to be set.
AWS_DEFAULT_REGION=auto

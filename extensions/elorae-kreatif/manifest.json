{
  "manifest_version": 3,
  "name": "Elorae Kreatif — Pantau KOL",
  "short_name": "Elorae Kreatif",
  "version": "0.3.1",
  "description": "Membaca angka profil dan video TikTok KOL lalu mengirimkannya ke Elorae (uji coba pemantauan).",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://www.tiktok.com/*", "http://localhost:3000/*", "https://elorae.cloud/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Elorae Kreatif — Pantau KOL",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["halaman-utama.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["konten.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/pengurai.js", "lib/panel.js", "lib/tampilan.js"],
      "matches": ["https://www.tiktok.com/*"]
    }
  ]
}
